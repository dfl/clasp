<!DOCTYPE html>
<html>
<head>
    <style>
        body {
            background: #121212;
            color: #fff;
            font-family: system-ui;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100vh;
            margin: 0;
            user-select: none;
        }
        .container {
            background: #1e1e1e;
            padding: 2rem;
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
            text-align: center;
        }
        input[type=range] { width: 200px; margin: 20px 0; }
        .value { font-size: 2rem; color: #00d4ff; }
    </style>
</head>
<body>
    <div class="container">
        <h1 id="title">PLUGIN_NAME</h1>
        <input type="range" id="gainSlider" min="0" max="2" step="0.01" value="1">
        <div class="value" id="gainValue">1.00</div>
    </div>
    <script>
        const slider = document.getElementById('gainSlider');
        const valDisp = document.getElementById('gainValue');

        slider.oninput = () => {
            const val = parseFloat(slider.value);
            valDisp.innerText = val.toFixed(2);
            if (window.clasp) clasp.setParam(0, val);
        };

        window.onClaspReady = () => {
            const val = clasp.getParam(0);
            slider.value = val;
            valDisp.innerText = val.toFixed(2);
            clasp.onParamChange = (id, v) => {
                if (id === 0) {
                    slider.value = v;
                    valDisp.innerText = v.toFixed(2);
                }
            };
        };
    </script>
</body>
</html>
