let sampleRate: f32 = 44100.0;
let gain: f32 = 1.0;

const NUM_CHANNELS = 2;
const MAX_BLOCK_SIZE = 4096;

const inputBuffers = new Float32Array(NUM_CHANNELS * MAX_BLOCK_SIZE);
const outputBuffers = new Float32Array(NUM_CHANNELS * MAX_BLOCK_SIZE);

export function dsp_init(rate: f32, maxBlockSize: i32): void {
  sampleRate = rate;
  gain = 1.0;
}

export function dsp_process(blockSize: i32): void {
  for (let ch = 0; ch < NUM_CHANNELS; ch++) {
    let offset = ch * MAX_BLOCK_SIZE;
    for (let i = 0; i < blockSize; i++) {
       outputBuffers[offset + i] = inputBuffers[offset + i] * gain;
    }
  }
}

export function dsp_set_param(id: i32, value: f32): void {
  if (id == 0) gain = value;
}

export function dsp_get_param(id: i32): f32 {
  return id == 0 ? gain : 0.0;
}

export function dsp_get_input_buffer(channel: i32): usize {
  if (channel < 0 || channel >= NUM_CHANNELS) return 0;
  return inputBuffers.dataStart + (channel * MAX_BLOCK_SIZE * 4);
}

export function dsp_get_output_buffer(channel: i32): usize {
  if (channel < 0 || channel >= NUM_CHANNELS) return 0;
  return outputBuffers.dataStart + (channel * MAX_BLOCK_SIZE * 4);
}

// Optional - MPE support
export function dsp_note_on(offset: i32, note_id: i16, channel: i16, key: i16, velocity: f32): void {}
export function dsp_note_off(offset: i32, note_id: i16, channel: i16, key: i16, velocity: f32): void {}
export function dsp_note_expression(offset: i32, note_id: i16, channel: i16, key: i16, expr_id: i32, value: f32): void {}
