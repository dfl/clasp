cmake_minimum_required(VERSION 3.21)
project(PLUGIN_ID LANGUAGES CXX)

set(CLASP_ROOT "${CMAKE_CURRENT_SOURCE_DIR}/../..")
include(${CLASP_ROOT}/cmake/FetchWasiSdk.cmake)

set(CMAKE_C_COMPILER "${WASI_SDK_PREFIX}/bin/clang")
set(CMAKE_CXX_COMPILER "${WASI_SDK_PREFIX}/bin/clang++")
set(CMAKE_SYSROOT "${WASI_SDK_SYSROOT}")

add_custom_command(
    OUTPUT dsp.wasm
    COMMAND ${CMAKE_CXX_COMPILER}
        --target=wasm32-wasi
        --sysroot=${WASI_SDK_SYSROOT}
        -O3 -nostdlib -Wl,--no-entry -Wl,--export-dynamic
        -o dsp.wasm ${CMAKE_CURRENT_SOURCE_DIR}/src/dsp.cpp
    DEPENDS src/dsp.cpp
)

add_custom_target(dsp_module ALL DEPENDS dsp.wasm)

set(BUNDLE_DIR "${CMAKE_CURRENT_BINARY_DIR}/PLUGIN_NAME.clasp")
add_custom_command(
    TARGET dsp_module POST_BUILD
    COMMAND ${CMAKE_COMMAND} -E make_directory ${BUNDLE_DIR}
    COMMAND ${CMAKE_COMMAND} -E copy dsp.wasm ${BUNDLE_DIR}/dsp.wasm
    COMMAND ${CMAKE_COMMAND} -E copy ${CMAKE_CURRENT_SOURCE_DIR}/plugin.json ${BUNDLE_DIR}/plugin.json
    COMMAND ${CMAKE_COMMAND} -E copy_directory ${CMAKE_CURRENT_SOURCE_DIR}/ui ${BUNDLE_DIR}/ui
)
