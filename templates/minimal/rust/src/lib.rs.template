//! {{PLUGIN_NAME}} - WCLAP Audio Plugin

// Plugin state
static mut GAIN: f32 = 0.5;
static mut INPUT: [[f32; 4096]; 2] = [[0.0; 4096]; 2];
static mut OUTPUT: [[f32; 4096]; 2] = [[0.0; 4096]; 2];

#[no_mangle]
pub extern "C" fn dsp_init(_sample_rate: f32, _max_block_size: i32) {
    // Initialize plugin
}

#[no_mangle]
pub extern "C" fn dsp_process(block_size: i32) {
    unsafe {
        for ch in 0..2 {
            for i in 0..block_size as usize {
                OUTPUT[ch][i] = INPUT[ch][i] * GAIN;
            }
        }
    }
}

#[no_mangle]
pub extern "C" fn dsp_set_param(id: i32, value: f32) {
    unsafe {
        if id == 0 {
            GAIN = value;
        }
    }
}

#[no_mangle]
pub extern "C" fn dsp_get_param(id: i32) -> f32 {
    unsafe {
        if id == 0 { GAIN } else { 0.0 }
    }
}

#[no_mangle]
pub extern "C" fn dsp_get_input_buffer(channel: i32) -> *mut f32 {
    unsafe { INPUT[channel as usize].as_mut_ptr() }
}

#[no_mangle]
pub extern "C" fn dsp_get_output_buffer(channel: i32) -> *mut f32 {
    unsafe { OUTPUT[channel as usize].as_mut_ptr() }
}
